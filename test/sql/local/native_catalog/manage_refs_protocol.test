# name: test/sql/local/native_catalog/manage_refs_protocol.test
# description: Ref management refuses read-only attaches and cyclic lineage; the mock enforces assert-ref-snapshot-id and ref retention like the spec
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

require json

statement ok
CREATE TABLE my_datalake.default.refs_protocol (id INTEGER);

foreach id 1 2 3

statement ok
INSERT INTO my_datalake.default.refs_protocol VALUES ({id});

statement ok
SET VARIABLE s{id} = (SELECT snapshot_id::BIGINT FROM iceberg_snapshots(my_datalake.default.refs_protocol)
	ORDER BY sequence_number DESC LIMIT 1);

endloop

statement ok
SELECT * FROM iceberg_create_branch('my_datalake.default.refs_protocol', 'dev', snapshot_id := getvariable('s1'));

# A read-only attach refuses every ref change
statement ok
ATTACH '' AS ro_lake (TYPE ICEBERG, URI 'http://iceberg-mock.invalid', AUTHORIZATION_TYPE 'none',
	ACCESS_DELEGATION_MODE 'none', READ_ONLY);

statement error
SELECT * FROM iceberg_create_branch('ro_lake.default.refs_protocol', 'ro');
----
<REGEX>:.*read-only.*

statement error
SELECT * FROM iceberg_create_tag('ro_lake.default.refs_protocol', 'ro');
----
<REGEX>:.*read-only.*

statement error
SELECT * FROM iceberg_drop_branch('ro_lake.default.refs_protocol', 'dev');
----
<REGEX>:.*read-only.*

statement error
SELECT * FROM iceberg_fast_forward('ro_lake.default.refs_protocol', 'dev', 'main');
----
<REGEX>:.*read-only.*

statement error
SELECT * FROM iceberg_set_current_snapshot('ro_lake.default.refs_protocol', getvariable('s1'));
----
<REGEX>:.*read-only.*

statement ok
DETACH ro_lake;

query TT
SELECT name, snapshot_id = CASE name WHEN 'dev' THEN getvariable('s1') ELSE getvariable('s3') END
FROM iceberg_refs(my_datalake.default.refs_protocol) ORDER BY name;
----
dev	true
main	true

# Untrusted metadata with a parent cycle (s2 -> s3 -> s2) must not hang the ancestry walk
statement ok
SET VARIABLE original = (
	SELECT body FROM iceberg_test_catalog_request('GET', '/v1/namespaces/default/tables/refs_protocol', NULL)
);

statement ok
SET VARIABLE cyclic = (
	SELECT json_merge_patch(getvariable('original'), json_object('metadata', json_object('snapshots',
		(SELECT json_group_array(CASE WHEN json_extract(value, '$."snapshot-id"')::BIGINT = getvariable('s2')
			THEN json_merge_patch(value, json_object('parent-snapshot-id', getvariable('s3'))) ELSE value END)
		FROM json_each(getvariable('original'), '$.metadata.snapshots')))))
);

query I
SELECT status FROM iceberg_test_catalog_request('POST', '/__test/response',
	json_object('method', 'GET', 'path', '/v1/namespaces/default/tables/refs_protocol', 'status', 200,
		'body', getvariable('cyclic'))::VARCHAR);
----
204

statement error
SELECT * FROM iceberg_fast_forward('my_datalake.default.refs_protocol', 'dev', 'main');
----
contains a cycle

statement error
SELECT * FROM iceberg_rollback_to_snapshot('my_datalake.default.refs_protocol', getvariable('s1'));
----
contains a cycle

query I
SELECT status FROM iceberg_test_catalog_request('DELETE', '/__test/response', NULL);
----
204

# Without the cycle the same fast-forward succeeds
query TTT
SELECT branch_updated, previous_ref = getvariable('s1'), updated_ref = getvariable('s3')
FROM iceberg_fast_forward('my_datalake.default.refs_protocol', 'dev', 'main');
----
dev	true	true

# assert-ref-snapshot-id requires snapshot-id: a missing key is not a null
query I
SELECT status FROM iceberg_test_catalog_request('POST', '/v1/namespaces/default/tables/refs_protocol',
	'{"requirements":[{"type":"assert-ref-snapshot-id","ref":"absent"}],"updates":[]}');
----
400

query I
SELECT status FROM iceberg_test_catalog_request('POST', '/v1/namespaces/default/tables/refs_protocol',
	'{"requirements":[{"type":"assert-ref-snapshot-id","ref":"absent","snapshot-id":null}],"updates":[]}');
----
200

query I
SELECT status FROM iceberg_test_catalog_request('POST', '/v1/namespaces/default/tables/refs_protocol',
	'{"requirements":[{"type":"assert-ref-snapshot-id","ref":"dev","snapshot-id":null}],"updates":[]}');
----
409

# Ref retention follows Java's SnapshotRef: positive values, and tags keep no snapshots
foreach retention "type":"tag","min-snapshots-to-keep":1 "type":"tag","max-snapshot-age-ms":1 "type":"branch","max-ref-age-ms":0 "type":"branch","min-snapshots-to-keep":-1 "type":"branch","max-snapshot-age-ms":1.5 "type":"branch","min-snapshots-to-keep":2147483648

query I
SELECT status FROM iceberg_test_catalog_request('POST', '/v1/namespaces/default/tables/refs_protocol',
	'{"requirements":[],"updates":[{"action":"set-snapshot-ref","ref-name":"bad","snapshot-id":'
		|| getvariable('s1') || ',{retention}}]}');
----
400

endloop

query I
SELECT status FROM iceberg_test_catalog_request('POST', '/v1/namespaces/default/tables/refs_protocol',
	'{"requirements":[],"updates":[{"action":"set-snapshot-ref","ref-name":"good","snapshot-id":'
		|| getvariable('s1') || ',"type":"tag","max-ref-age-ms":1}]}');
----
200

query T
SELECT list(name ORDER BY name) FROM iceberg_refs(my_datalake.default.refs_protocol);
----
[dev, good, main]

# Like Java's removeRef, removing an unknown ref is a no-op, but requirements are still checked first
query I
SELECT status FROM iceberg_test_catalog_request('POST', '/v1/namespaces/default/tables/refs_protocol',
	'{"requirements":[],"updates":[{"action":"remove-snapshot-ref","ref-name":"absent"}]}');
----
200

query I
SELECT status FROM iceberg_test_catalog_request('POST', '/v1/namespaces/default/tables/refs_protocol',
	'{"requirements":[{"type":"assert-ref-snapshot-id","ref":"absent","snapshot-id":'
		|| getvariable('s1') || '}],"updates":[{"action":"remove-snapshot-ref","ref-name":"absent"}]}');
----
409

# Ref types are matched case-insensitively, as on reads: an out-of-spec "BRANCH" is a branch, not unknown
statement ok
SET VARIABLE original = (
	SELECT body FROM iceberg_test_catalog_request('GET', '/v1/namespaces/default/tables/refs_protocol', NULL)
);

statement ok
SET VARIABLE upper_type = (
	SELECT json_merge_patch(getvariable('original'), json_object('metadata', json_object('refs',
		json_object('dev', json_object('type', 'BRANCH')))))
);

query I
SELECT status FROM iceberg_test_catalog_request('POST', '/__test/response',
	json_object('method', 'GET', 'path', '/v1/namespaces/default/tables/refs_protocol', 'status', 200,
		'body', getvariable('upper_type'))::VARCHAR);
----
204

statement error
SELECT * FROM iceberg_drop_tag('my_datalake.default.refs_protocol', 'dev');
----
Iceberg ref 'dev' is a branch, not a tag

query I
SELECT status FROM iceberg_test_catalog_request('DELETE', '/__test/response', NULL);
----
204

statement ok
DROP TABLE my_datalake.default.refs_protocol;
