# name: test/sql/local/native_catalog/wap_branch_safety.test
# description: iceberg_wap_branch never reads main in place of a missing branch, keeps pending changes on their branch, and refuses unsafe commits
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

require json

# Moves (or creates) a ref through the catalog, as another engine would
statement ok
SET VARIABLE set_ref = $$
SELECT status FROM iceberg_test_catalog_request('POST', '/v1/namespaces/default/tables/TBL',
	'{"requirements": [], "updates": [{"action": "set-snapshot-ref", "ref-name": "REF", "type": "TYPE", "snapshot-id": SNAP}]}')
$$;

statement ok
SET VARIABLE remove_ref = $$
SELECT status FROM iceberg_test_catalog_request('POST', '/v1/namespaces/default/tables/TBL',
	'{"requirements": [], "updates": [{"action": "remove-snapshot-ref", "ref-name": "REF"}]}')
$$;

# ---------------------------------------------------------------------------
# Setting validation

statement error
SET GLOBAL iceberg_wap_branch = 'audit';
----
can only be set for the session

statement error
SET iceberg_wap_branch = 'Main';
----
must be exactly 'main'

statement error
SET iceberg_wap_branch = 'MAIN';
----
must be exactly 'main'

# Numbers follow Java's Long.parseLong, as AT (VERSION => '...') does
statement error
SET iceberg_wap_branch = '+12';
----
must not be a number

statement error
SET iceberg_wap_branch = '-5';
----
must not be a number

# Not numbers for Long.parseLong, so these are ref names
statement ok
SET iceberg_wap_branch = '1e3';

statement ok
SET iceberg_wap_branch = '99999999999999999999';

statement ok
SET iceberg_wap_branch = '0x10';

# Long.parseLong also reads non-ASCII decimal digits, so names containing them are rejected
statement error
SET iceberg_wap_branch = '١٢٣';
----
must not contain non-ASCII digits

statement error
SET iceberg_wap_branch = '１２';
----
must not contain non-ASCII digits

statement error
SET iceberg_wap_branch = 'audit-٣';
----
must not contain non-ASCII digits

statement ok
SET iceberg_wap_branch = 'audit-é';

statement ok
RESET iceberg_wap_branch;

# ---------------------------------------------------------------------------
# A missing branch is never read as main

statement ok
CREATE TABLE my_datalake.default.wap_safe (id INTEGER);

statement ok
INSERT INTO my_datalake.default.wap_safe VALUES (1), (2);

statement ok
SET VARIABLE main_1 = (SELECT snapshot_id FROM iceberg_refs(my_datalake.default.wap_safe) WHERE name = 'main');

statement ok
SET iceberg_wap_branch = 'audit';

statement error
SELECT count(*) FROM my_datalake.default.wap_safe;
----
Iceberg branch 'audit' (set by 'iceberg_wap_branch') does not exist

statement error
SELECT count(*) FROM iceberg_scan_plan('my_datalake.default.wap_safe');
----
Iceberg branch 'audit' (set by 'iceberg_wap_branch') does not exist

statement error
SELECT count(*) FROM iceberg_files(my_datalake.default.wap_safe);
----
Iceberg branch 'audit' (set by 'iceberg_wap_branch') does not exist

statement error
SELECT count(*) FROM iceberg_metadata(my_datalake.default.wap_safe);
----
Iceberg branch 'audit' (set by 'iceberg_wap_branch') does not exist

# DELETE, UPDATE and MERGE read the branch first
statement error
DELETE FROM my_datalake.default.wap_safe WHERE id = 1;
----
Iceberg branch 'audit' (set by 'iceberg_wap_branch') does not exist

# Main stays readable explicitly
query I
SELECT count(*) FROM my_datalake.default.wap_safe AT (VERSION => 'main');
----
2

# Strict mode refuses to create the branch
statement ok
SET iceberg_wap_branch_create_missing = false;

statement error
INSERT INTO my_datalake.default.wap_safe VALUES (3);
----
does not exist in table "wap_safe", and 'iceberg_wap_branch_create_missing' is false

query I
SELECT count(*) FROM iceberg_refs(my_datalake.default.wap_safe) WHERE name = 'audit';
----
0

statement ok
RESET iceberg_wap_branch_create_missing;

# A transaction that creates the branch reads its pending state
statement ok
BEGIN;

statement ok
INSERT INTO my_datalake.default.wap_safe VALUES (3);

query I
SELECT id FROM my_datalake.default.wap_safe ORDER BY id;
----
1
2
3

# An explicit read of main does not see changes staged for the branch
query I
SELECT id FROM my_datalake.default.wap_safe AT (VERSION => 'main') ORDER BY id;
----
1
2

statement ok
COMMIT;

# iceberg_scan and metadata functions do not include pending changes, so they refuse a branch the transaction is
# creating rather than show main's data under its name
statement ok
SET iceberg_wap_branch = 'audit_pending';

statement ok
BEGIN;

statement ok
INSERT INTO my_datalake.default.wap_safe VALUES (7);

statement error
SELECT count(*) FROM iceberg_scan('my_datalake.default.wap_safe');
----
Iceberg branch 'audit_pending' of table "wap_safe" is created by this transaction

statement ok
ROLLBACK;

statement ok
BEGIN;

statement ok
INSERT INTO my_datalake.default.wap_safe VALUES (7);

statement error
SELECT count(*) FROM iceberg_files(my_datalake.default.wap_safe);
----
Iceberg branch 'audit_pending' of table "wap_safe" is created by this transaction

statement ok
ROLLBACK;

query I
SELECT count(*) FROM iceberg_refs(my_datalake.default.wap_safe) WHERE name = 'audit_pending';
----
0

statement ok
SET iceberg_wap_branch = 'audit';

statement ok
SET VARIABLE audit_1 = (SELECT snapshot_id FROM iceberg_refs(my_datalake.default.wap_safe) WHERE name = 'audit');

# Strict mode still writes to an existing branch
statement ok
SET iceberg_wap_branch_create_missing = false;

statement ok
INSERT INTO my_datalake.default.wap_safe VALUES (4);

statement ok
RESET iceberg_wap_branch_create_missing;

# Pending changes are visible exactly on the branch they target
statement ok
BEGIN;

statement ok
INSERT INTO my_datalake.default.wap_safe VALUES (5);

query I
SELECT count(*) FROM my_datalake.default.wap_safe;
----
5

query I
SELECT count(*) FROM my_datalake.default.wap_safe AT (VERSION => 'audit');
----
5

query I
SELECT count(*) FROM my_datalake.default.wap_safe AT (VERSION => 'main');
----
2

statement ok
COMMIT;

statement ok
RESET iceberg_wap_branch;

statement ok
BEGIN;

statement ok
INSERT INTO my_datalake.default.wap_safe VALUES (100);

query I
SELECT count(*) FROM my_datalake.default.wap_safe;
----
3

query I
SELECT count(*) FROM my_datalake.default.wap_safe AT (VERSION => 'main');
----
3

query I
SELECT count(*) FROM my_datalake.default.wap_safe AT (VERSION => 'audit');
----
5

statement ok
COMMIT;

# Metadata functions, iceberg_scan and iceberg_scan_plan read the WAP branch unless a snapshot option is given
statement ok
SET iceberg_wap_branch = 'audit';

query I
SELECT count(*) FROM iceberg_files(my_datalake.default.wap_safe);
----
4

query I
SELECT count(*) FROM iceberg_files(my_datalake.default.wap_safe, snapshot_from_ref => 'main');
----
2

query I
SELECT count(*) FROM iceberg_metadata(my_datalake.default.wap_safe);
----
4

query I
SELECT count(*) FROM iceberg_manifests(my_datalake.default.wap_safe);
----
4

query I
SELECT count(*) FROM iceberg_scan('my_datalake.default.wap_safe');
----
5

query I
SELECT count(*) FROM iceberg_scan_plan('my_datalake.default.wap_safe');
----
4

query I
SELECT count(*) FROM iceberg_scan_plan('my_datalake.default.wap_safe', snapshot_from_ref => 'main');
----
2

# Rollback and rewrite move main, so they are refused while a branch is targeted
statement error
SELECT * FROM iceberg_rollback_to_snapshot('my_datalake.default.wap_safe', getvariable('main_1'));
----
rollback moves main

statement error
SELECT * FROM iceberg_rewrite_data_files('my_datalake.default.wap_safe', rewrite_all := true);
----
Cannot rewrite data files of table "wap_safe" while 'iceberg_wap_branch' is set to 'audit'

statement ok
RESET iceberg_wap_branch;

query I
SELECT count(*) FROM my_datalake.default.wap_safe;
----
3

statement ok
DROP TABLE my_datalake.default.wap_safe;

# ---------------------------------------------------------------------------
# A branch write to a table whose main has no snapshot is refused and leaves the table empty: the branch's first
# snapshot would have no parent, which catalogs exempt from the sequence-number check

statement ok
CREATE TABLE my_datalake.default.wap_empty (id INTEGER);

statement ok
SET iceberg_wap_branch = 'audit';

statement error
INSERT INTO my_datalake.default.wap_empty VALUES (1);
----
Cannot create Iceberg branch 'audit' of table "wap_empty": main has no snapshot yet

statement ok
RESET iceberg_wap_branch;

query I
SELECT count(*) FROM my_datalake.default.wap_empty;
----
0

query I
SELECT count(*) FROM iceberg_snapshots(my_datalake.default.wap_empty);
----
0

query I
SELECT count(*) FROM iceberg_refs(my_datalake.default.wap_empty);
----
0

statement ok
DROP TABLE my_datalake.default.wap_empty;

# ---------------------------------------------------------------------------
# A table whose main has no snapshot but which has other refs (as another engine leaves an empty table it wrote a branch
# of) refuses every commit without a parent: catalogs do not check a parent-less snapshot's sequence number, so one
# staged on stale metadata could lower last-sequence-number and later deletes would miss newer rows. Only a table with
# no ref other than main takes a parent-less commit. The mock can not remove main, so the load response is scripted.

statement ok
CREATE TABLE my_datalake.default.wap_nomain (id INTEGER);

# A truly empty table still takes its first insert on main
statement ok
INSERT INTO my_datalake.default.wap_nomain VALUES (1);

statement ok
SET VARIABLE nomain_snapshot = (
	SELECT snapshot_id FROM iceberg_refs(my_datalake.default.wap_nomain) WHERE name = 'main'
);

query I
SELECT * FROM query(getvariable('set_ref').replace('TBL', 'wap_nomain').replace('REF', 'audit').replace('TYPE', 'branch')
	.replace('SNAP', getvariable('nomain_snapshot')::VARCHAR));
----
200

# The load response without main: refs.main, current-snapshot-id and the main snapshot-log removed
statement ok
SET VARIABLE nomain_load = (
	SELECT json_merge_patch(body, '{"metadata": {"current-snapshot-id": null, "refs": {"main": null}, "snapshot-log": []}}')
	FROM iceberg_test_catalog_request('GET', '/v1/namespaces/default/tables/wap_nomain', NULL)
);

statement ok
SET VARIABLE script_nomain = $$
SELECT status FROM iceberg_test_catalog_request('POST', '/__test/response',
	'{"method": "GET", "path": "/v1/namespaces/default/tables/wap_nomain", "status": 200, "body": BODY}')
$$;

query I
SELECT * FROM query(getvariable('script_nomain').replace('BODY', getvariable('nomain_load')));
----
204

query I
SELECT count(*) FROM iceberg_refs(my_datalake.default.wap_nomain) WHERE name = 'main';
----
0

statement ok
SET VARIABLE nomain_seq = (
	SELECT max(sequence_number) FROM iceberg_snapshots(my_datalake.default.wap_nomain)
);

# A main insert is refused when the statement binds
statement error
INSERT INTO my_datalake.default.wap_nomain VALUES (2);
----
Cannot commit to Iceberg branch 'main' of table "wap_nomain": main has no snapshot but the table has other branches or tags

# Creating a new branch from the missing main is refused with the same reason
statement ok
SET iceberg_wap_branch = 'audit2';

statement error
INSERT INTO my_datalake.default.wap_nomain VALUES (3);
----
Cannot commit to Iceberg branch 'audit2' of table "wap_nomain": main has no snapshot but the table has other branches or tags

statement ok
RESET iceberg_wap_branch;

# Old snapshots that no ref points at (as a CREATE OR REPLACE leaves them) do not block main's first insert: its
# sequence number is above all of them, and no other ref can receive concurrent commits
statement ok
SET VARIABLE replaced_load = (
	SELECT json_merge_patch(body, '{"metadata": {"current-snapshot-id": null, "refs": {"main": null, "audit": null}, "snapshot-log": []}}')
	FROM iceberg_test_catalog_request('GET', '/v1/namespaces/default/tables/wap_nomain', NULL)
);

query I
SELECT * FROM query(getvariable('script_nomain').replace('BODY', getvariable('replaced_load')));
----
204

query I
SELECT count(*) FROM iceberg_refs(my_datalake.default.wap_nomain);
----
0

statement ok
BEGIN;

statement ok
INSERT INTO my_datalake.default.wap_nomain VALUES (4);

statement ok
ROLLBACK;

# A branch is still never created from the missing main
statement ok
SET iceberg_wap_branch = 'audit3';

statement error
INSERT INTO my_datalake.default.wap_nomain VALUES (5);
----
Cannot create Iceberg branch 'audit3' of table "wap_nomain": main has no snapshot yet

statement ok
RESET iceberg_wap_branch;

query I
SELECT status FROM iceberg_test_catalog_request('DELETE', '/__test/response', NULL);
----
204

# Nothing was committed
query I
SELECT count(*) FROM iceberg_snapshots(my_datalake.default.wap_nomain);
----
1

query I
SELECT max(sequence_number) = getvariable('nomain_seq') FROM iceberg_snapshots(my_datalake.default.wap_nomain);
----
true

query I
SELECT name FROM iceberg_refs(my_datalake.default.wap_nomain) ORDER BY name;
----
audit
main

query I
SELECT * FROM my_datalake.default.wap_nomain;
----
1

statement ok
DROP TABLE my_datalake.default.wap_nomain;

# The check is repeated on the refreshed metadata of every commit attempt: a main insert bound on a truly empty table
# whose commit conflicts, after which the table shows a branch snapshot and no main, is refused, not retried
statement ok
CREATE TABLE my_datalake.default.wap_nomain_race (id INTEGER);

statement ok
CREATE TABLE my_datalake.default.wap_nomain_src (id INTEGER);

statement ok
INSERT INTO my_datalake.default.wap_nomain_src VALUES (7);

statement ok
BEGIN;

statement ok
INSERT INTO my_datalake.default.wap_nomain_race VALUES (1);

# Another engine's branch snapshot on the empty table, as the refreshed load will show it: the source table's
# load with the race table's identity, its main removed and its snapshot on branch 'audit'
statement ok
SET VARIABLE race_load = (
	SELECT json_merge_patch(src.body, json_object('metadata', json_object(
		'table-uuid', race.body->>'$.metadata.table-uuid',
		'location', race.body->>'$.metadata.location',
		'current-snapshot-id', NULL,
		'snapshot-log', json('[]'),
		'refs', json_object('main', NULL, 'audit', src.body->'$.metadata.refs.main'))))
	FROM iceberg_test_catalog_request('GET', '/v1/namespaces/default/tables/wap_nomain_src', NULL) AS src,
		iceberg_test_catalog_request('GET', '/v1/namespaces/default/tables/wap_nomain_race', NULL) AS race
);

query I
SELECT * FROM query(getvariable('script_nomain').replace('wap_nomain', 'wap_nomain_race').replace('BODY', getvariable('race_load')));
----
204

query I
SELECT status FROM iceberg_test_catalog_request('POST', '/__test/response',
	'{"method": "POST", "path": "/v1/transactions/commit", "status": 409, "body": {"error": {"message": "Requirement failed: branch main was created concurrently", "type": "CommitFailedException", "code": 409}}}');
----
204

statement error
COMMIT;
----
Cannot commit to Iceberg branch 'main' of table "wap_nomain_race": main has no snapshot but the table has other branches or tags

query I
SELECT status FROM iceberg_test_catalog_request('DELETE', '/__test/response', NULL);
----
204

# The only commit that tried to add a snapshot to the table is the one the scripted 409 answered: the refused
# attempt sent no second commit, and nothing was committed
query II
SELECT count(*), count(*) FILTER (WHERE status = 409)
FROM read_json_auto('{TEMP_DIR}/iceberg-native/*/requests.jsonl')
WHERE method = 'POST' AND path = '/v1/transactions/commit' AND request LIKE '%wap_nomain_race%'
	AND request LIKE '%add-snapshot%';
----
1	1

query I
SELECT count(*) FROM iceberg_snapshots(my_datalake.default.wap_nomain_race);
----
0

statement ok
DROP TABLE my_datalake.default.wap_nomain_race;

statement ok
DROP TABLE my_datalake.default.wap_nomain_src;

# ---------------------------------------------------------------------------
# DELETE retries on a branch (write.delete.isolation-level = snapshot)

statement ok
CREATE TABLE my_datalake.default.wap_del (id INTEGER) WITH ('write.delete.isolation-level' = 'snapshot');

statement ok
INSERT INTO my_datalake.default.wap_del VALUES (1), (2), (3);

statement ok
SET VARIABLE del_main = (SELECT snapshot_id FROM iceberg_refs(my_datalake.default.wap_del) WHERE name = 'main');

statement ok con1
SET iceberg_wap_branch = 'audit';

statement ok con2
SET iceberg_wap_branch = 'audit';

statement ok con1
INSERT INTO my_datalake.default.wap_del VALUES (4);

statement ok
SET VARIABLE del_a1 = (SELECT snapshot_id FROM iceberg_refs(my_datalake.default.wap_del) WHERE name = 'audit');

statement ok con1
INSERT INTO my_datalake.default.wap_del VALUES (5);

# A DELETE is re-applied over concurrent appends to its branch
statement ok con1
BEGIN;

statement ok con1
DELETE FROM my_datalake.default.wap_del WHERE id = 1;

statement ok con2
INSERT INTO my_datalake.default.wap_del VALUES (6);

statement ok con1
COMMIT;

query I con1
SELECT id FROM my_datalake.default.wap_del ORDER BY id;
----
2
3
4
5
6

# ... and over concurrent commits to main, which are not on its branch
statement ok con1
BEGIN;

statement ok con1
DELETE FROM my_datalake.default.wap_del WHERE id = 2;

statement ok
DELETE FROM my_datalake.default.wap_del WHERE id = 3;

statement ok con1
COMMIT;

query I con1
SELECT id FROM my_datalake.default.wap_del ORDER BY id;
----
3
4
5
6

query I
SELECT id FROM my_datalake.default.wap_del ORDER BY id;
----
1
2

# A branch reset to an older snapshot while the DELETE ran: its base is no longer on the branch
statement ok con1
BEGIN;

statement ok con1
DELETE FROM my_datalake.default.wap_del WHERE id = 4;

query I
SELECT * FROM query(getvariable('set_ref').replace('TBL', 'wap_del').replace('REF', 'audit').replace('TYPE', 'branch').replace('SNAP', getvariable('del_a1')::VARCHAR));
----
200

statement error con1
COMMIT;
----
conflicts with a concurrent commit

query I con1
SELECT id FROM my_datalake.default.wap_del ORDER BY id;
----
1
2
3
4

# A branch recreated from main while the DELETE ran
statement ok con1
BEGIN;

statement ok con1
DELETE FROM my_datalake.default.wap_del WHERE id = 1;

query I
SELECT * FROM query(getvariable('remove_ref').replace('TBL', 'wap_del').replace('REF', 'audit'));
----
200

query I
SELECT * FROM query(getvariable('set_ref').replace('TBL', 'wap_del').replace('REF', 'audit').replace('TYPE', 'branch').replace('SNAP', getvariable('del_main')::VARCHAR));
----
200

statement error con1
COMMIT;
----
conflicts with a concurrent commit

# A branch removed while the transaction ran is not recreated from main
statement ok con1
BEGIN;

statement ok con1
INSERT INTO my_datalake.default.wap_del VALUES (7);

query I
SELECT * FROM query(getvariable('remove_ref').replace('TBL', 'wap_del').replace('REF', 'audit'));
----
200

statement error con1
COMMIT;
----
was removed concurrently

query T
SELECT name FROM iceberg_refs(my_datalake.default.wap_del) ORDER BY name;
----
main

# A branch created as a tag while the transaction ran is not written to
statement ok con1
BEGIN;

statement ok con1
INSERT INTO my_datalake.default.wap_del VALUES (8);

query I
SELECT * FROM query(getvariable('set_ref').replace('TBL', 'wap_del').replace('REF', 'audit').replace('TYPE', 'tag').replace('SNAP', getvariable('del_main')::VARCHAR));
----
200

statement error con1
COMMIT;
----
is a tag, not a branch

query TT
SELECT name, type FROM iceberg_refs(my_datalake.default.wap_del) ORDER BY name;
----
audit	TAG
main	BRANCH

# None of this moved main past the plain main DELETE
query I
SELECT count(*) FROM iceberg_snapshots(my_datalake.default.wap_del)
WHERE snapshot_id = (SELECT snapshot_id FROM iceberg_refs(my_datalake.default.wap_del) WHERE name = 'main')
AND parent_id = getvariable('del_main');
----
1

statement ok con1
RESET iceberg_wap_branch;

statement ok con2
RESET iceberg_wap_branch;

statement ok
DROP TABLE my_datalake.default.wap_del;

# ---------------------------------------------------------------------------
# Multi-table transactions: each table commits to the branch it was written under

statement ok
CREATE TABLE my_datalake.default.wap_t1 (id INTEGER);

statement ok
CREATE TABLE my_datalake.default.wap_t2 (id INTEGER);

statement ok
INSERT INTO my_datalake.default.wap_t1 VALUES (1);

statement ok
INSERT INTO my_datalake.default.wap_t2 VALUES (1);

statement ok
SET VARIABLE t1_main = (SELECT snapshot_id FROM iceberg_refs(my_datalake.default.wap_t1) WHERE name = 'main');

statement ok
SET VARIABLE t2_main = (SELECT snapshot_id FROM iceberg_refs(my_datalake.default.wap_t2) WHERE name = 'main');

statement ok
BEGIN;

statement ok
SET iceberg_wap_branch = 'b1';

statement ok
INSERT INTO my_datalake.default.wap_t1 VALUES (2);

statement ok
SET iceberg_wap_branch = 'b2';

statement ok
INSERT INTO my_datalake.default.wap_t2 VALUES (2);

statement ok
COMMIT;

statement ok
RESET iceberg_wap_branch;

query TT
SELECT name, snapshot_id = getvariable('t1_main') FROM iceberg_refs(my_datalake.default.wap_t1) ORDER BY name;
----
b1	false
main	true

query TT
SELECT name, snapshot_id = getvariable('t2_main') FROM iceberg_refs(my_datalake.default.wap_t2) ORDER BY name;
----
b2	false
main	true

query I
SELECT count(*) FROM my_datalake.default.wap_t1 AT (VERSION => 'b1');
----
2

query I
SELECT count(*) FROM my_datalake.default.wap_t2 AT (VERSION => 'b2');
----
2

# One table on a branch, the other on main
statement ok
BEGIN;

statement ok
SET iceberg_wap_branch = 'b1';

statement ok
INSERT INTO my_datalake.default.wap_t1 VALUES (3);

statement ok
RESET iceberg_wap_branch;

statement ok
INSERT INTO my_datalake.default.wap_t2 VALUES (3);

statement ok
COMMIT;

query I
SELECT snapshot_id = getvariable('t1_main') FROM iceberg_refs(my_datalake.default.wap_t1) WHERE name = 'main';
----
true

query I
SELECT count(*) FROM my_datalake.default.wap_t1 AT (VERSION => 'b1');
----
3

query I
SELECT count(*) FROM my_datalake.default.wap_t2;
----
2

query I
SELECT count(*) FROM my_datalake.default.wap_t2 AT (VERSION => 'b2');
----
2

statement ok
DROP TABLE my_datalake.default.wap_t1;

statement ok
DROP TABLE my_datalake.default.wap_t2;

# ---------------------------------------------------------------------------
# Format version 3: UPDATE and MERGE on a branch keep row lineage, and concurrent main writes keep row ids unique

statement ok
CREATE TABLE my_datalake.default.wap_v3 (id INTEGER, v VARCHAR) WITH ('format-version' = 3);

statement ok
INSERT INTO my_datalake.default.wap_v3 VALUES (1, 'a'), (2, 'b');

# UPDATE reads the branch, so it must exist: create it at main, as another engine would
statement ok
SET VARIABLE v3_main = (SELECT snapshot_id FROM iceberg_refs(my_datalake.default.wap_v3) WHERE name = 'main');

query I
SELECT * FROM query(getvariable('set_ref').replace('TBL', 'wap_v3').replace('REF', 'audit').replace('TYPE', 'branch').replace('SNAP', getvariable('v3_main')::VARCHAR));
----
200

statement ok
SET iceberg_wap_branch = 'audit';

statement ok
UPDATE my_datalake.default.wap_v3 SET v = 'A' WHERE id = 1;

statement ok
SET VARIABLE audit_seq = (SELECT sequence_number FROM iceberg_snapshots(my_datalake.default.wap_v3)
	WHERE snapshot_id = (SELECT snapshot_id FROM iceberg_refs(my_datalake.default.wap_v3) WHERE name = 'audit'));

query ITIT
SELECT id, v, _row_id, _last_updated_sequence_number = getvariable('audit_seq')
FROM my_datalake.default.wap_v3 ORDER BY id;
----
1	A	0	true
2	b	1	false

statement ok
MERGE INTO my_datalake.default.wap_v3 t
USING (VALUES (2, 'B'), (3, 'c')) s(id, v) ON t.id = s.id
WHEN MATCHED THEN UPDATE SET v = s.v
WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.v);

statement ok
SET VARIABLE audit_seq = (SELECT sequence_number FROM iceberg_snapshots(my_datalake.default.wap_v3)
	WHERE snapshot_id = (SELECT snapshot_id FROM iceberg_refs(my_datalake.default.wap_v3) WHERE name = 'audit'));

query ITIT
SELECT id, v, _row_id, _last_updated_sequence_number = getvariable('audit_seq')
FROM my_datalake.default.wap_v3 ORDER BY id;
----
1	A	0	false
2	B	1	true
3	c	4	true

# Main is untouched
query TII
SELECT v, _row_id, _last_updated_sequence_number FROM my_datalake.default.wap_v3 AT (VERSION => 'main') ORDER BY id;
----
a	0	1
b	1	1

# A branch write concurrent with a main write
statement ok con1
SET iceberg_wap_branch = 'audit';

statement ok con1
BEGIN;

statement ok con1
INSERT INTO my_datalake.default.wap_v3 VALUES (10, 'branch');

statement ok con2
INSERT INTO my_datalake.default.wap_v3 VALUES (20, 'main');

statement ok con1
COMMIT;

statement ok con1
RESET iceberg_wap_branch;

query II
SELECT id, _row_id FROM my_datalake.default.wap_v3 AT (VERSION => 'audit') ORDER BY id;
----
1	0
2	1
3	4
10	6

query II
SELECT id, _row_id FROM my_datalake.default.wap_v3 AT (VERSION => 'main') ORDER BY id;
----
1	0
2	1
20	5

statement ok
RESET iceberg_wap_branch;

statement ok
DROP TABLE my_datalake.default.wap_v3;
