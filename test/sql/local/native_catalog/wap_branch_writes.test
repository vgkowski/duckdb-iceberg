# name: test/sql/local/native_catalog/wap_branch_writes.test
# description: iceberg_wap_branch commits INSERT, DELETE, UPDATE and MERGE to a branch without moving main (Write-Audit-Publish)
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

require json

# Branch names that could not be read back by name, or that hide typos, are rejected
statement error
SET iceberg_wap_branch = '123';
----
must not be a number

statement error
SET iceberg_wap_branch = ' audit';
----
must not start or end with whitespace

statement error
SET iceberg_wap_branch = E'au\ndit';
----
must not contain control characters

statement ok
CREATE TABLE my_datalake.default.wap (id INTEGER, v VARCHAR);

statement ok
INSERT INTO my_datalake.default.wap VALUES (1, 'a'), (2, 'b');

statement ok
SET VARIABLE main_snapshot = (SELECT snapshot_id FROM iceberg_refs(my_datalake.default.wap) WHERE name = 'main');

# A branch that does not exist yet is not read as main (unlike Spark), so an audit never sees main by mistake
statement ok
SET iceberg_wap_branch = 'audit';

statement error
SELECT count(*) FROM my_datalake.default.wap;
----
does not exist in this table, and reads do not fall back to main

# The first commit creates the branch from main's current snapshot
statement ok
INSERT INTO my_datalake.default.wap VALUES (3, 'c');

query II
SELECT id, v FROM my_datalake.default.wap ORDER BY id;
----
1	a
2	b
3	c

query I
SELECT count(*) FROM my_datalake.default.wap AT (VERSION => 'main');
----
2

query TTT
SELECT name, type, snapshot_id = getvariable('main_snapshot') FROM iceberg_refs(my_datalake.default.wap) ORDER BY name;
----
audit	BRANCH	false
main	BRANCH	true

# The branch snapshot's parent is main's snapshot
query I
SELECT parent_id = getvariable('main_snapshot') FROM iceberg_snapshots(my_datalake.default.wap)
WHERE snapshot_id = (SELECT snapshot_id FROM iceberg_refs(my_datalake.default.wap) WHERE name = 'audit');
----
true

# The catalog's current snapshot (main) did not move
query I
SELECT (metadata::JSON->>'current-snapshot-id')::BIGINT = getvariable('main_snapshot')
FROM iceberg_load_table_response(my_datalake.default.wap);
----
true

statement ok
SET VARIABLE audit_1 = (SELECT snapshot_id FROM iceberg_refs(my_datalake.default.wap) WHERE name = 'audit');

# Later commits build on the branch head
statement ok
INSERT INTO my_datalake.default.wap VALUES (4, 'd');

query I
SELECT parent_id = getvariable('audit_1') FROM iceberg_snapshots(my_datalake.default.wap)
WHERE snapshot_id = (SELECT snapshot_id FROM iceberg_refs(my_datalake.default.wap) WHERE name = 'audit');
----
true

statement ok
DELETE FROM my_datalake.default.wap WHERE id = 1;

statement ok
UPDATE my_datalake.default.wap SET v = 'B' WHERE id = 2;

statement ok
MERGE INTO my_datalake.default.wap t
USING (VALUES (3, 'C'), (5, 'e')) s(id, v) ON t.id = s.id
WHEN MATCHED THEN UPDATE SET v = s.v
WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.v);

query II
SELECT id, v FROM my_datalake.default.wap ORDER BY id;
----
2	B
3	C
4	d
5	e

# Readers of main see the old state
statement ok
RESET iceberg_wap_branch;

query II
SELECT id, v FROM my_datalake.default.wap ORDER BY id;
----
1	a
2	b

query II
SELECT id, v FROM my_datalake.default.wap AT (VERSION => 'audit') ORDER BY id;
----
2	B
3	C
4	d
5	e

query I
SELECT snapshot_id = getvariable('main_snapshot') FROM iceberg_refs(my_datalake.default.wap) WHERE name = 'main';
----
true

# Main moves independently of the branch
statement ok
INSERT INTO my_datalake.default.wap VALUES (10, 'main');

query I
SELECT count(*) FROM my_datalake.default.wap AT (VERSION => 'audit');
----
4

query I
SELECT count(*) FROM my_datalake.default.wap;
----
3

# 'main' (or the empty string) targets main
statement ok
SET iceberg_wap_branch = 'main';

statement ok
INSERT INTO my_datalake.default.wap VALUES (11, 'main');

query I
SELECT count(*) FROM my_datalake.default.wap AT (VERSION => 'main');
----
4

statement ok
RESET iceberg_wap_branch;

# Tags can not be written to or used as the WAP branch
statement ok
SET VARIABLE q = $$
SELECT status FROM iceberg_test_catalog_request('POST', '/v1/namespaces/default/tables/wap',
	'{"requirements": [], "updates": [{"action": "set-snapshot-ref", "ref-name": "release", "type": "tag", "snapshot-id": SNAP}]}')
$$;

query I
SELECT * FROM query(getvariable('q').replace('SNAP', getvariable('main_snapshot')::VARCHAR));
----
200

statement ok
SET iceberg_wap_branch = 'release';

statement error
INSERT INTO my_datalake.default.wap VALUES (99, 'tag');
----
is a tag, not a branch

statement error
SELECT count(*) FROM my_datalake.default.wap;
----
is a tag, not a branch

statement ok
RESET iceberg_wap_branch;

query I
SELECT snapshot_id = getvariable('main_snapshot') FROM iceberg_refs(my_datalake.default.wap) WHERE name = 'release';
----
true

# The branch can not change within a transaction that wrote to the table
statement ok
BEGIN;

statement ok
SET iceberg_wap_branch = 'audit';

statement ok
INSERT INTO my_datalake.default.wap VALUES (20, 'x');

statement ok
RESET iceberg_wap_branch;

statement error
SELECT count(*) FROM my_datalake.default.wap;
----
was changed on branch 'audit' in this transaction

statement ok
ROLLBACK;

statement ok
BEGIN;

statement ok
SET iceberg_wap_branch = 'audit';

statement ok
INSERT INTO my_datalake.default.wap VALUES (20, 'x');

statement ok
RESET iceberg_wap_branch;

statement error
INSERT INTO my_datalake.default.wap VALUES (21, 'y');
----
was changed on branch 'audit' in this transaction

statement ok
ROLLBACK;

query I
SELECT count(*) FROM my_datalake.default.wap AT (VERSION => 'audit');
----
4

# A transaction reads its own pending branch writes
statement ok
SET iceberg_wap_branch = 'audit';

statement ok
BEGIN;

statement ok
INSERT INTO my_datalake.default.wap VALUES (30, 'z');

query I
SELECT count(*) FROM my_datalake.default.wap;
----
5

statement ok
COMMIT;

query I
SELECT count(*) FROM my_datalake.default.wap;
----
5

# A table created in the transaction gets its first commit on main
statement error
CREATE TABLE my_datalake.default.wap_new AS SELECT 1 AS id;
----
it is created in this transaction

# Reading a table created in the transaction names the reason, rather than a missing branch
statement ok
BEGIN;

statement ok
CREATE TABLE my_datalake.default.wap_new (id INTEGER);

statement error
SELECT count(*) FROM my_datalake.default.wap_new;
----
Table "wap_new" is created in this transaction, so it has no branch 'audit' to read

statement ok
ROLLBACK;

# iceberg_scan and metadata functions give the same error
statement ok
BEGIN;

statement ok
CREATE TABLE my_datalake.default.wap_new (id INTEGER);

statement error
SELECT count(*) FROM iceberg_scan('my_datalake.default.wap_new');
----
Table "wap_new" is created in this transaction, so it has no branch 'audit' to read

statement ok
ROLLBACK;

statement ok
BEGIN;

statement ok
CREATE TABLE my_datalake.default.wap_new (id INTEGER);

statement error
SELECT count(*) FROM iceberg_files(my_datalake.default.wap_new);
----
Table "wap_new" is created in this transaction, so it has no branch 'audit' to read

statement ok
ROLLBACK;

statement ok
RESET iceberg_wap_branch;

statement ok
DROP TABLE my_datalake.default.wap;

# Format version 3: row ids stay table-wide unique across branches
statement ok
CREATE TABLE my_datalake.default.wap_v3 (id INTEGER) WITH ('format-version' = 3);

statement ok
INSERT INTO my_datalake.default.wap_v3 VALUES (1), (2);

statement ok
SET iceberg_wap_branch = 'audit';

statement ok
INSERT INTO my_datalake.default.wap_v3 VALUES (3);

statement ok
DELETE FROM my_datalake.default.wap_v3 WHERE id = 1;

statement ok
RESET iceberg_wap_branch;

statement ok
INSERT INTO my_datalake.default.wap_v3 VALUES (4);

query II
SELECT id, _row_id FROM my_datalake.default.wap_v3 ORDER BY id;
----
1	0
2	1
4	3

query II
SELECT id, _row_id FROM my_datalake.default.wap_v3 AT (VERSION => 'audit') ORDER BY id;
----
2	1
3	2

statement ok
DROP TABLE my_datalake.default.wap_v3;
