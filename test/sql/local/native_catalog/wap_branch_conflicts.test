# name: test/sql/local/native_catalog/wap_branch_conflicts.test
# description: iceberg_wap_branch commits assert the target branch, retry appends onto its new head and leave main alone
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

require json

statement ok
CREATE TABLE my_datalake.default.wap_conflicts (id INTEGER);

statement ok
INSERT INTO my_datalake.default.wap_conflicts VALUES (1);

statement ok
SET VARIABLE main_snapshot = (
	SELECT snapshot_id FROM iceberg_refs(my_datalake.default.wap_conflicts) WHERE name = 'main'
);

statement ok con1
SET iceberg_wap_branch = 'audit';

statement ok con2
SET iceberg_wap_branch = 'audit';

# Two writers create the same branch: the second commit fails the branch-absent assertion and its append is retried
# onto the branch the first one created
statement ok con1
BEGIN;

statement ok con1
INSERT INTO my_datalake.default.wap_conflicts VALUES (2);

statement ok con2
INSERT INTO my_datalake.default.wap_conflicts VALUES (3);

statement ok con1
COMMIT;

query I con1
SELECT id FROM my_datalake.default.wap_conflicts ORDER BY id;
----
1
2
3

# Appends to an existing branch are retried onto its new head
statement ok con1
BEGIN;

statement ok con1
INSERT INTO my_datalake.default.wap_conflicts VALUES (4);

statement ok con2
INSERT INTO my_datalake.default.wap_conflicts VALUES (5);

statement ok con1
COMMIT;

query I con2
SELECT count(*) FROM my_datalake.default.wap_conflicts;
----
5

# A DELETE is not re-applied over a concurrent commit to its branch
statement ok con1
BEGIN;

statement ok con1
DELETE FROM my_datalake.default.wap_conflicts WHERE id = 1;

statement ok con2
INSERT INTO my_datalake.default.wap_conflicts VALUES (6);

statement error con1
COMMIT;
----
conflicts with a concurrent commit

# Commits to main do not conflict with a commit to the branch, and the branch commit does not move main
statement ok con1
BEGIN;

statement ok con1
DELETE FROM my_datalake.default.wap_conflicts WHERE id = 1;

statement ok
INSERT INTO my_datalake.default.wap_conflicts VALUES (100);

statement ok con1
COMMIT;

query I con1
SELECT id FROM my_datalake.default.wap_conflicts ORDER BY id;
----
2
3
4
5
6

query I
SELECT id FROM my_datalake.default.wap_conflicts ORDER BY id;
----
1
100

query I
SELECT parent_id = getvariable('main_snapshot') FROM iceberg_snapshots(my_datalake.default.wap_conflicts)
WHERE snapshot_id = (SELECT snapshot_id FROM iceberg_refs(my_datalake.default.wap_conflicts) WHERE name = 'main');
----
true

# An UPDATE is not retried, so a concurrent commit to main fails it with a conflict rather than the catalog's 400
statement ok con1
BEGIN;

statement ok con1
UPDATE my_datalake.default.wap_conflicts SET id = id + 10 WHERE id = 2;

statement ok
INSERT INTO my_datalake.default.wap_conflicts VALUES (101);

statement error con1
COMMIT;
----
conflicts with a concurrent commit to another branch of "wap_conflicts"; re-run

query I con1
SELECT id FROM my_datalake.default.wap_conflicts ORDER BY id;
----
2
3
4
5
6

query I
SELECT id FROM my_datalake.default.wap_conflicts ORDER BY id;
----
1
100
101

statement ok
DROP TABLE my_datalake.default.wap_conflicts;

# With retries disabled, an append to an existing branch racing a commit to main fails with the same conflict
statement ok
CREATE TABLE my_datalake.default.wap_no_retry (id INTEGER) WITH ('commit.retry.num-retries' = '0');

statement ok
INSERT INTO my_datalake.default.wap_no_retry VALUES (1);

# Creates the branch (sequence number 2), so the race below is not on main's assertion
statement ok con1
INSERT INTO my_datalake.default.wap_no_retry VALUES (2);

statement ok con1
BEGIN;

statement ok con1
INSERT INTO my_datalake.default.wap_no_retry VALUES (3);

statement ok
INSERT INTO my_datalake.default.wap_no_retry VALUES (4);

statement error con1
COMMIT;
----
conflicts with a concurrent commit to another branch of "wap_no_retry"; re-run the transaction (catalog: Cannot add snapshot with sequence number 3 older than last sequence number 3)

query I con1
SELECT id FROM my_datalake.default.wap_no_retry ORDER BY id;
----
1
2

statement ok
DROP TABLE my_datalake.default.wap_no_retry;


# A branch is never created while main has no snapshot: its first snapshot would have no parent, which Java catalogs
# exempt from the sequence-number check, so a stale staged number would not be above last-sequence-number
statement ok
CREATE TABLE my_datalake.default.wap_parentless (id INTEGER);

statement error con1
INSERT INTO my_datalake.default.wap_parentless VALUES (1);
----
Cannot create Iceberg branch 'audit' of table "wap_parentless": main has no snapshot yet

statement ok con1
BEGIN;

statement error con1
INSERT INTO my_datalake.default.wap_parentless VALUES (1);
----
Insert into main first

statement ok con1
ROLLBACK;

# Concurrent commits to main, then a DELETE on main: the deleted row stays deleted and sequence numbers only grow
statement ok
INSERT INTO my_datalake.default.wap_parentless VALUES (1);

statement ok
INSERT INTO my_datalake.default.wap_parentless VALUES (2);

statement ok
INSERT INTO my_datalake.default.wap_parentless VALUES (3);

statement ok
DELETE FROM my_datalake.default.wap_parentless WHERE id = 3;

query I
SELECT id FROM my_datalake.default.wap_parentless ORDER BY id;
----
1
2

query I
SELECT count(*) FROM iceberg_refs(my_datalake.default.wap_parentless) WHERE name = 'audit';
----
0

statement ok
DROP TABLE my_datalake.default.wap_parentless;

# Regression: a branch-creating commit raced by two main commits fails its assertion of main with a 409 and is
# re-staged above them onto main's new head, so a later DELETE on main covers every row it should, and no commit
# lowered the table's last sequence number
statement ok
CREATE TABLE my_datalake.default.wap_seq (id INTEGER);

statement ok
INSERT INTO my_datalake.default.wap_seq VALUES (1);

statement ok con1
BEGIN;

statement ok con1
INSERT INTO my_datalake.default.wap_seq VALUES (10);

statement ok
INSERT INTO my_datalake.default.wap_seq VALUES (2);

statement ok
INSERT INTO my_datalake.default.wap_seq VALUES (3);

statement ok
SET VARIABLE moved_main = (SELECT snapshot_id FROM iceberg_refs(my_datalake.default.wap_seq) WHERE name = 'main');

statement ok con1
COMMIT;

# The branch starts from main's new head, and main did not move
query II
SELECT
	(SELECT parent_id FROM iceberg_snapshots(my_datalake.default.wap_seq) WHERE snapshot_id = (
		SELECT snapshot_id FROM iceberg_refs(my_datalake.default.wap_seq) WHERE name = 'audit'
	)) = getvariable('moved_main'),
	(SELECT snapshot_id FROM iceberg_refs(my_datalake.default.wap_seq) WHERE name = 'main') = getvariable('moved_main');
----
true	true

query I con1
SELECT id FROM my_datalake.default.wap_seq ORDER BY id;
----
1
2
3
10

statement ok
DELETE FROM my_datalake.default.wap_seq WHERE id = 3;

query I
SELECT id FROM my_datalake.default.wap_seq ORDER BY id;
----
1
2

# Five snapshots (three main appends, the branch append, the delete) with distinct sequence numbers 1..5, the delete
# last
query III
SELECT count(*), count(DISTINCT sequence_number), max(sequence_number) FROM iceberg_snapshots(my_datalake.default.wap_seq);
----
5	5	5

query I
SELECT operation FROM iceberg_snapshots(my_datalake.default.wap_seq) ORDER BY sequence_number DESC LIMIT 1;
----
delete

statement ok
DROP TABLE my_datalake.default.wap_seq;

# Without retries, the failed main assertion aborts the branch-creating commit: no branch, main unchanged
statement ok
CREATE TABLE my_datalake.default.wap_create_no_retry (id INTEGER) WITH ('commit.retry.num-retries' = '0');

statement ok
INSERT INTO my_datalake.default.wap_create_no_retry VALUES (1);

statement ok con1
BEGIN;

statement ok con1
INSERT INTO my_datalake.default.wap_create_no_retry VALUES (10);

statement ok
INSERT INTO my_datalake.default.wap_create_no_retry VALUES (2);

statement ok
SET VARIABLE moved_main = (
	SELECT snapshot_id FROM iceberg_refs(my_datalake.default.wap_create_no_retry) WHERE name = 'main'
);

statement error con1
COMMIT;
----
Requirement failed: assert-ref-snapshot-id

query II
SELECT count(*) FILTER (name = 'audit'), bool_and(snapshot_id = getvariable('moved_main')) FILTER (name = 'main')
FROM iceberg_refs(my_datalake.default.wap_create_no_retry);
----
0	true

query I
SELECT id FROM my_datalake.default.wap_create_no_retry ORDER BY id;
----
1
2

statement ok
DROP TABLE my_datalake.default.wap_create_no_retry;

# A multi-table commit names only the table the catalog rejected, with the catalog's message
statement ok
CREATE TABLE my_datalake.default.wap_multi_a (id INTEGER);

statement ok
CREATE TABLE my_datalake.default.wap_multi_b (id INTEGER);

statement ok
INSERT INTO my_datalake.default.wap_multi_a VALUES (1);

statement ok
INSERT INTO my_datalake.default.wap_multi_b VALUES (1);

statement ok
INSERT INTO my_datalake.default.wap_multi_b VALUES (2);

statement ok
INSERT INTO my_datalake.default.wap_multi_b VALUES (3);

statement ok
INSERT INTO my_datalake.default.wap_multi_b VALUES (4);

statement ok con1
INSERT INTO my_datalake.default.wap_multi_a VALUES (2);

statement ok con1
INSERT INTO my_datalake.default.wap_multi_b VALUES (5);

statement ok con1
BEGIN;

statement ok con1
UPDATE my_datalake.default.wap_multi_a SET id = id + 10 WHERE id = 1;

statement ok con1
INSERT INTO my_datalake.default.wap_multi_b VALUES (6);

statement ok
INSERT INTO my_datalake.default.wap_multi_a VALUES (100);

statement error con1
COMMIT;
----
conflicts with a concurrent commit to another branch of "wap_multi_a"; re-run the transaction (catalog: Cannot add snapshot with sequence number 3 older than last sequence number 3)

query I con1
SELECT count(*) FROM my_datalake.default.wap_multi_b;
----
5

statement ok
DROP TABLE my_datalake.default.wap_multi_a;

statement ok
DROP TABLE my_datalake.default.wap_multi_b;

# A 400 that does not describe this commit's own stale sequence number is reported as the catalog's error, neither
# retried nor reworded as a conflict. The catalog's answers are scripted.
statement ok
CREATE TABLE my_datalake.default.wap_other_400 (id INTEGER);

statement ok
INSERT INTO my_datalake.default.wap_other_400 VALUES (1);

statement ok con1
INSERT INTO my_datalake.default.wap_other_400 VALUES (2);

statement ok
SET VARIABLE script_400 = $$
SELECT status FROM iceberg_test_catalog_request('POST', '/__test/response',
	'{"method": "POST", "path": "PATH", "status": 400, "body": {"error": {"message": "MESSAGE", "type": "ValidationException", "code": 400}}}')
$$;

# A number this commit did not stamp (it stamps 3)
query I
SELECT * FROM query(getvariable('script_400').replace('PATH', '/v1/transactions/commit')
	.replace('MESSAGE', 'Cannot add snapshot with sequence number 99 older than last sequence number 100'));
----
204

query I
SELECT * FROM query(getvariable('script_400').replace('PATH', '/v1/namespaces/default/tables/wap_other_400')
	.replace('MESSAGE', 'Cannot add snapshot with sequence number 99 older than last sequence number 100'));
----
204

# Not retryable (UPDATE)
statement error con1
UPDATE my_datalake.default.wap_other_400 SET id = 20 WHERE id = 2;
----
message: Cannot add snapshot with sequence number 99 older than last sequence number 100

# Retryable (append): reported before any cleanup or refresh, so it is not retried
statement error con1
INSERT INTO my_datalake.default.wap_other_400 VALUES (3);
----
message: Cannot add snapshot with sequence number 99 older than last sequence number 100

# A number this commit stamped, but a message that does not parse
query I
SELECT * FROM query(getvariable('script_400').replace('PATH', '/v1/transactions/commit')
	.replace('MESSAGE', 'Cannot add snapshot with sequence number 3 older than last sequence number 3, see logs'));
----
204

query I
SELECT * FROM query(getvariable('script_400').replace('PATH', '/v1/namespaces/default/tables/wap_other_400')
	.replace('MESSAGE', 'Cannot add snapshot with sequence number 3 older than last sequence number 3, see logs'));
----
204

statement error con1
UPDATE my_datalake.default.wap_other_400 SET id = 20 WHERE id = 2;
----
message: Cannot add snapshot with sequence number 3 older than last sequence number 3, see logs

statement ok
SET VARIABLE gets_before = (SELECT count(*) FROM read_json_auto('{TEMP_DIR}/iceberg-native/*/requests.jsonl')
	WHERE method = 'GET' AND path = '/v1/namespaces/default/tables/wap_other_400');

statement error con1
INSERT INTO my_datalake.default.wap_other_400 VALUES (3);
----
message: Cannot add snapshot with sequence number 3 older than last sequence number 3, see logs

# The unparsable message was reported without refreshing the table after the failed commit: the append loaded the
# table once, at bind
query I
SELECT count(*) - getvariable('gets_before') FROM read_json_auto('{TEMP_DIR}/iceberg-native/*/requests.jsonl')
WHERE method = 'GET' AND path = '/v1/namespaces/default/tables/wap_other_400';
----
1

# A number this commit stamped, written with a leading zero: Java never pads these numbers (Long.toString), so the
# message does not parse
query I
SELECT * FROM query(getvariable('script_400').replace('PATH', '/v1/transactions/commit')
	.replace('MESSAGE', 'Cannot add snapshot with sequence number 03 older than last sequence number 3'));
----
204

query I
SELECT * FROM query(getvariable('script_400').replace('PATH', '/v1/namespaces/default/tables/wap_other_400')
	.replace('MESSAGE', 'Cannot add snapshot with sequence number 03 older than last sequence number 3'));
----
204

statement error con1
UPDATE my_datalake.default.wap_other_400 SET id = 20 WHERE id = 2;
----
message: Cannot add snapshot with sequence number 03 older than last sequence number 3

statement error con1
INSERT INTO my_datalake.default.wap_other_400 VALUES (3);
----
message: Cannot add snapshot with sequence number 03 older than last sequence number 3

query I
SELECT status FROM iceberg_test_catalog_request('DELETE', '/__test/response', NULL);
----
204

# Each statement sent one commit: none was retried
query I
SELECT count(*) FROM read_json_auto('{TEMP_DIR}/iceberg-native/*/requests.jsonl')
WHERE method = 'POST' AND status = 400 AND request LIKE '%wap_other_400%';
----
6

query I con1
SELECT id FROM my_datalake.default.wap_other_400 ORDER BY id;
----
1
2

statement ok
DROP TABLE my_datalake.default.wap_other_400;
