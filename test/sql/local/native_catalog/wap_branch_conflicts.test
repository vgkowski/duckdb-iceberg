# name: test/sql/local/native_catalog/wap_branch_conflicts.test
# description: iceberg_wap_branch commits assert the target branch, retry appends onto its new head and leave main alone
# group: [native_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

statement ok
CREATE TABLE my_datalake.default.wap_conflicts (id INTEGER);

statement ok
INSERT INTO my_datalake.default.wap_conflicts VALUES (1);

statement ok
SET VARIABLE main_snapshot = (
	SELECT snapshot_id FROM iceberg_refs(my_datalake.default.wap_conflicts) WHERE name = 'main'
);

statement ok con1
SET iceberg_wap_branch = 'audit';

statement ok con2
SET iceberg_wap_branch = 'audit';

# Two writers create the same branch: the second commit fails the branch-absent assertion and its append is retried
# onto the branch the first one created
statement ok con1
BEGIN;

statement ok con1
INSERT INTO my_datalake.default.wap_conflicts VALUES (2);

statement ok con2
INSERT INTO my_datalake.default.wap_conflicts VALUES (3);

statement ok con1
COMMIT;

query I con1
SELECT id FROM my_datalake.default.wap_conflicts ORDER BY id;
----
1
2
3

# Appends to an existing branch are retried onto its new head
statement ok con1
BEGIN;

statement ok con1
INSERT INTO my_datalake.default.wap_conflicts VALUES (4);

statement ok con2
INSERT INTO my_datalake.default.wap_conflicts VALUES (5);

statement ok con1
COMMIT;

query I con2
SELECT count(*) FROM my_datalake.default.wap_conflicts;
----
5

# A DELETE is not re-applied over a concurrent commit to its branch
statement ok con1
BEGIN;

statement ok con1
DELETE FROM my_datalake.default.wap_conflicts WHERE id = 1;

statement ok con2
INSERT INTO my_datalake.default.wap_conflicts VALUES (6);

statement error con1
COMMIT;
----
conflicts with a concurrent commit

# Commits to main do not conflict with a commit to the branch, and the branch commit does not move main
statement ok con1
BEGIN;

statement ok con1
DELETE FROM my_datalake.default.wap_conflicts WHERE id = 1;

statement ok
INSERT INTO my_datalake.default.wap_conflicts VALUES (100);

statement ok con1
COMMIT;

query I con1
SELECT id FROM my_datalake.default.wap_conflicts ORDER BY id;
----
2
3
4
5
6

query I
SELECT id FROM my_datalake.default.wap_conflicts ORDER BY id;
----
1
100

query I
SELECT parent_id = getvariable('main_snapshot') FROM iceberg_snapshots(my_datalake.default.wap_conflicts)
WHERE snapshot_id = (SELECT snapshot_id FROM iceberg_refs(my_datalake.default.wap_conflicts) WHERE name = 'main');
----
true

# An UPDATE is not retried, so a concurrent commit to main fails it with a conflict rather than the catalog's 400
statement ok con1
BEGIN;

statement ok con1
UPDATE my_datalake.default.wap_conflicts SET id = id + 10 WHERE id = 2;

statement ok
INSERT INTO my_datalake.default.wap_conflicts VALUES (101);

statement error con1
COMMIT;
----
conflicts with a concurrent commit to another branch of "wap_conflicts"; re-run

query I con1
SELECT id FROM my_datalake.default.wap_conflicts ORDER BY id;
----
2
3
4
5
6

query I
SELECT id FROM my_datalake.default.wap_conflicts ORDER BY id;
----
1
100
101

statement ok
DROP TABLE my_datalake.default.wap_conflicts;

# With retries disabled, an append racing a commit to main fails with the same conflict
statement ok
CREATE TABLE my_datalake.default.wap_no_retry (id INTEGER) WITH ('commit.retry.num-retries' = '0');

statement ok
INSERT INTO my_datalake.default.wap_no_retry VALUES (1);

statement ok con1
BEGIN;

statement ok con1
INSERT INTO my_datalake.default.wap_no_retry VALUES (2);

statement ok
INSERT INTO my_datalake.default.wap_no_retry VALUES (3);

statement error con1
COMMIT;
----
conflicts with a concurrent commit to another branch of "wap_no_retry"; re-run

query I
SELECT count(*) FROM iceberg_refs(my_datalake.default.wap_no_retry) WHERE name = 'audit';
----
0

statement ok
DROP TABLE my_datalake.default.wap_no_retry;

# As Java's TableMetadata builder, a snapshot without a parent is exempt from the sequence-number check: a branch
# created while main has no snapshot commits beside a concurrent first commit to main, even without retries
statement ok
CREATE TABLE my_datalake.default.wap_parentless (id INTEGER) WITH ('commit.retry.num-retries' = '0');

statement ok con1
BEGIN;

statement ok con1
INSERT INTO my_datalake.default.wap_parentless VALUES (1);

statement ok
INSERT INTO my_datalake.default.wap_parentless VALUES (2);

statement ok con1
COMMIT;

query I con1
SELECT id FROM my_datalake.default.wap_parentless;
----
1

query I
SELECT id FROM my_datalake.default.wap_parentless;
----
2

statement ok
DROP TABLE my_datalake.default.wap_parentless;
