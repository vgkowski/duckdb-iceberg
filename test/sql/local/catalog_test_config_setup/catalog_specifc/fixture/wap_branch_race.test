# name: test/sql/local/catalog_test_config_setup/catalog_specifc/fixture/wap_branch_race.test
# description: A branch commit raced by a main commit is retried on apache/iceberg-rest-fixture, and the table's last-sequence-number stays monotonic
# group: [fixture]

# Iceberg's TableMetadata.Builder.addSnapshot rejects a snapshot with a parent whose sequence number is not above the
# table's last-sequence-number (server-side, apache-iceberg-1.10.1,
# core/src/main/java/org/apache/iceberg/TableMetadata.java:1250-1259). The branch's assert-ref-snapshot-id holds, so
# servers before Iceberg 1.11 answer a 400 ValidationException (apache/iceberg#15001). An append retries it on the
# refreshed metadata; an UPDATE fails with the conflict error. This also runs in the fixture-latest lane
# (test/configs/fixture-latest.json), whose server answers 409 instead (apache/iceberg#15126, server-side): the append
# is retried by the usual conflict retry with the same outcome, and the UPDATE reports the 409 as is.

require-env CATALOG_TEST_CONFIG_SETUP fixture

include test/sql/init_requires

require json

statement ok
DROP TABLE IF EXISTS my_datalake.default.wap_race;

statement ok
CREATE TABLE my_datalake.default.wap_race (id INTEGER);

statement ok
INSERT INTO my_datalake.default.wap_race VALUES (1);

statement ok con1
SET iceberg_wap_branch = 'wap_race_audit';

statement ok con1
BEGIN;

# Staged on last-sequence-number 1, so its snapshot is stamped 2
statement ok con1
INSERT INTO my_datalake.default.wap_race VALUES (10);

# Main's commit takes sequence number 2 first
statement ok
INSERT INTO my_datalake.default.wap_race VALUES (2);

# The fixture's 400 is retried: re-staged with sequence number 3. The branch did not exist yet, so the retry creates
# it from main's refreshed current snapshot, as Java clients do (SnapshotUtil.latestSnapshot falls back to the
# current snapshot for a missing branch, client-side, apache-iceberg-1.10.1,
# core/src/main/java/org/apache/iceberg/util/SnapshotUtil.java:527-538)
statement ok con1
COMMIT;

query I con1
SELECT id FROM my_datalake.default.wap_race ORDER BY id;
----
1
2
10

query I
SELECT id FROM my_datalake.default.wap_race ORDER BY id;
----
1
2

query I
SELECT sequence_number FROM iceberg_snapshots(my_datalake.default.wap_race)
WHERE snapshot_id = (SELECT snapshot_id FROM iceberg_refs(my_datalake.default.wap_race) WHERE name = 'wap_race_audit');
----
3

# An UPDATE is not retried: the same race fails. The 1.10.1 fixture's 400 is reported with the conflict error, quoting
# its message; the fixture-latest lane's 409 (CatalogHandlers wraps the check in a CommitFailedException "Validation
# failed, please retry: ...", apache/iceberg#15126) is reported as is.
statement ok con1
BEGIN;

statement ok con1
UPDATE my_datalake.default.wap_race SET id = 11 WHERE id = 10;

statement ok
INSERT INTO my_datalake.default.wap_race VALUES (3);

statement error con1
COMMIT;
----
<REGEX>:.*(The commit conflicts with a concurrent commit to another branch of "wap_race"; re-run the transaction \(catalog: |Validation failed, please retry: )Cannot add snapshot with sequence number 4 older than last sequence number 4.*

statement ok con1
RESET iceberg_wap_branch;

query I
SELECT id FROM my_datalake.default.wap_race AT (VERSION => 'wap_race_audit') ORDER BY id;
----
1
2
10

# Every snapshot has its own sequence number, the latest being the table's last-sequence-number
query III
SELECT count(*), count(DISTINCT sequence_number), max(sequence_number) = (
	SELECT (metadata::JSON->>'last-sequence-number')::BIGINT FROM iceberg_load_table_response(my_datalake.default.wap_race)
)
FROM iceberg_snapshots(my_datalake.default.wap_race);
----
4	4	true

statement ok
DROP TABLE my_datalake.default.wap_race;
