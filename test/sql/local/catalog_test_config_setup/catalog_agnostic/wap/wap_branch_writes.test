# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/wap/wap_branch_writes.test
# description: INSERT, DELETE, UPDATE and MERGE under iceberg_wap_branch commit to the branch and never move main or current-snapshot-id
# group: [wap]

# Races and the native mock's scripted catalog responses are covered in test/sql/local/native_catalog/wap_branch_*.test

require-env CATALOG_TEST_CONFIG_SETUP

require-env TIMETRAVEL_SUPPORT

include test/sql/init_requires

require json

statement ok
DROP TABLE IF EXISTS my_datalake.default.wap_agnostic;

statement ok
CREATE TABLE my_datalake.default.wap_agnostic (id INTEGER);

statement ok
INSERT INTO my_datalake.default.wap_agnostic VALUES (1), (2), (3);

statement ok
SET VARIABLE main_snapshot = (
	SELECT snapshot_id FROM iceberg_refs(my_datalake.default.wap_agnostic) WHERE name = 'main'
);

query I
SELECT (metadata::JSON->>'current-snapshot-id')::BIGINT = getvariable('main_snapshot')
FROM iceberg_load_table_response(my_datalake.default.wap_agnostic);
----
true

statement ok
SET iceberg_wap_branch = 'wap_audit';

# The branch does not exist yet, and a read never falls back to main
statement error
SELECT count(*) FROM my_datalake.default.wap_agnostic;
----
Iceberg branch 'wap_audit' (set by 'iceberg_wap_branch') does not exist in this table

# The first INSERT creates the branch from main's current snapshot
statement ok
INSERT INTO my_datalake.default.wap_agnostic VALUES (4);

query III
SELECT name, type, snapshot_id = getvariable('main_snapshot')
FROM iceberg_refs(my_datalake.default.wap_agnostic) ORDER BY name;
----
main	BRANCH	true
wap_audit	BRANCH	false

query I
SELECT parent_id = getvariable('main_snapshot') FROM iceberg_snapshots(my_datalake.default.wap_agnostic)
WHERE snapshot_id = (SELECT snapshot_id FROM iceberg_refs(my_datalake.default.wap_agnostic) WHERE name = 'wap_audit');
----
true

# Main and the table's current snapshot did not move
query I
SELECT (metadata::JSON->>'current-snapshot-id')::BIGINT = getvariable('main_snapshot')
FROM iceberg_load_table_response(my_datalake.default.wap_agnostic);
----
true

query I
SELECT id FROM my_datalake.default.wap_agnostic ORDER BY id;
----
1
2
3
4

query I
SELECT id FROM my_datalake.default.wap_agnostic AT (VERSION => 'main') ORDER BY id;
----
1
2
3

# DELETE, UPDATE and MERGE read and commit to the branch
statement ok
DELETE FROM my_datalake.default.wap_agnostic WHERE id = 1;

statement ok
UPDATE my_datalake.default.wap_agnostic SET id = 20 WHERE id = 2;

statement ok
MERGE INTO my_datalake.default.wap_agnostic AS t
USING (SELECT * FROM (VALUES (3), (5)) v(id)) AS s
ON t.id = s.id
WHEN MATCHED THEN DELETE
WHEN NOT MATCHED THEN INSERT VALUES (s.id);

query I
SELECT id FROM my_datalake.default.wap_agnostic ORDER BY id;
----
4
5
20

# Each statement built on the branch head: the branch's history is four snapshots on top of main's
query I
SELECT count(*) FROM iceberg_snapshots(my_datalake.default.wap_agnostic);
----
5

query I
SELECT snapshot_id = getvariable('main_snapshot') FROM iceberg_refs(my_datalake.default.wap_agnostic) WHERE name = 'main';
----
true

query I
SELECT (metadata::JSON->>'current-snapshot-id')::BIGINT = getvariable('main_snapshot')
FROM iceberg_load_table_response(my_datalake.default.wap_agnostic);
----
true

query I
SELECT id FROM my_datalake.default.wap_agnostic AT (VERSION => 'main') ORDER BY id;
----
1
2
3

statement ok
RESET iceberg_wap_branch;

query I
SELECT id FROM my_datalake.default.wap_agnostic ORDER BY id;
----
1
2
3

query I
SELECT id FROM my_datalake.default.wap_agnostic AT (VERSION => 'wap_audit') ORDER BY id;
----
4
5
20

# Main moves independently of the branch, and every snapshot has its own sequence number, the latest being the
# table's last-sequence-number
statement ok
INSERT INTO my_datalake.default.wap_agnostic VALUES (6);

query I
SELECT id FROM my_datalake.default.wap_agnostic AT (VERSION => 'wap_audit') ORDER BY id;
----
4
5
20

query III
SELECT count(*), count(DISTINCT sequence_number), max(sequence_number) = (
	SELECT (metadata::JSON->>'last-sequence-number')::BIGINT FROM iceberg_load_table_response(my_datalake.default.wap_agnostic)
)
FROM iceberg_snapshots(my_datalake.default.wap_agnostic);
----
6	6	true

statement ok
DROP TABLE my_datalake.default.wap_agnostic;
