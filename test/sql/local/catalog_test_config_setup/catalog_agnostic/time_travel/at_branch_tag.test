# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/time_travel/at_branch_tag.test
# description: AT (VERSION => '<ref>') reads a branch or tag by name, as in Spark and Trino (duckdb-iceberg#1252)
# group: [time_travel]

require-env CATALOG_TEST_CONFIG_SETUP

require-env TIMETRAVEL_SUPPORT

include test/sql/init_requires

statement ok
drop table if exists my_datalake.default.at_branch_tag;

statement ok
create table my_datalake.default.at_branch_tag (id INTEGER);

statement ok
insert into my_datalake.default.at_branch_tag values (1), (2);

statement ok
insert into my_datalake.default.at_branch_tag values (3);

query I
select count(*) from my_datalake.default.at_branch_tag AT (VERSION => 'main');
----
3

# Inside a transaction, an explicit read of 'main' sees the transaction's own writes, like a plain read
statement ok
begin;

statement ok
insert into my_datalake.default.at_branch_tag values (4);

query II
select
	(select count(*) from my_datalake.default.at_branch_tag),
	(select count(*) from my_datalake.default.at_branch_tag AT (VERSION => 'main'));
----
4	4

statement ok
rollback;

# Strings that are not plain digits name a ref, as in Spark (Long.parseLong)
statement error
select count(*) from my_datalake.default.at_branch_tag AT (VERSION => ' 1 ');
----
Iceberg ref ' 1 ' does not exist

statement error
select count(*) from my_datalake.default.at_branch_tag AT (VERSION => '0x2A');
----
Iceberg ref '0x2A' does not exist

statement error
select count(*) from my_datalake.default.at_branch_tag AT (VERSION => '99999999999999999999');
----
Iceberg ref '99999999999999999999' does not exist

statement error
select count(*) from my_datalake.default.at_branch_tag AT (VERSION => '9223372036854775808');
----
Iceberg ref '9223372036854775808' does not exist

statement error
select count(*) from my_datalake.default.at_branch_tag AT (VERSION => '+');
----
Iceberg ref '+' does not exist

# Digits with a sign or leading zeros are a snapshot id
statement error
select count(*) from my_datalake.default.at_branch_tag AT (VERSION => '007');
----
Could not find snapshot with id 7

statement error
select count(*) from my_datalake.default.at_branch_tag AT (VERSION => '+5');
----
Could not find snapshot with id 5

statement error
select count(*) from my_datalake.default.at_branch_tag AT (VERSION => '-9223372036854775808');
----
Could not find snapshot with id -9223372036854775808

# A numeric string is still a snapshot id
statement ok
set variable first_snapshot = (
	select snapshot_id from iceberg_snapshots(my_datalake.default.at_branch_tag) order by sequence_number limit 1
);

statement ok
set variable q = $$ select count(*) from my_datalake.default.at_branch_tag AT (VERSION => 'SNAP') $$;

query I
select * from query(getvariable('q').replace('SNAP', getvariable('first_snapshot')::VARCHAR));
----
2

statement error
select count(*) from my_datalake.default.at_branch_tag AT (VERSION => 'audit');
----
Iceberg ref 'audit' does not exist

statement ok
drop table my_datalake.default.at_branch_tag;
